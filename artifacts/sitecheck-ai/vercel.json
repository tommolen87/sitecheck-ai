{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://sitecheck-ai-xvaf.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/nl",
      "permanent": true
    }
  ]
}
